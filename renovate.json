{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG BIBCOP_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "yegor256/bibcop",
      "datasourceTemplate": "github-releases"
    }
  ]
}
